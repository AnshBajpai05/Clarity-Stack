# ==========================================
# ClarityStack — Professional .gitignore
# ==========================================

# --- System ---
.DS_Store
Thumbs.db
*.log

# --- Environments & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/venv/
**/env/
**/.venv/
**/node_modules/
.env.*
**/.env
**/.env.*

# ...but keep committed templates so teammates know what to set
!.env.example
!**/.env.example

# --- Databases ---
*.db
*.sqlite3
**/claritystack.db
*.db-shm
*.db-wal

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.mypy_cache/

# --- Node.js / React ---
dist/
build/
.next/
.turbo/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Service Specific Data ---
/SRS_Service/data/raw_SRS_processed/
/SRS_Service/data/raw_SRS/
/UML_Clarity_Service/backend/temp/
/ThreatLens_Service/temp/
/Satellite/logs/

# --- User/Temp Files ---
c1.txt
claritystack.txt
scratch/
.gemini/
/Mobile/
/Daily_Progress_Track/
/temp_threatlens/
Architecture_Report.md
ClarityStack_Engineering_Report.md
ClarityStack_Enterprise_Audit_Report.md
final_implementation.md

# --- Runtime collab data (rewritten at runtime; §9.1) ---
/Editor_Service/data/

# --- Vite build artifacts (§9.1) ---
**/vite.config.ts.timestamp-*.mjs

# --- Generated corpora / large data — keep local, out of git (§9.1) ---
/SRS_Service/data/checkpoints/
**/pdf_raw_text.txt

# --- One lockfile per service: npm only, drop bun (§9.2) ---
*.lockb

# --- Ad-hoc scratch/debug scripts — dead, kept local (§9.1) ---
**/scratch_extract.py
/SRS_Service/test_regex.py
/SRS_Service/test_semantic.py
/SRS_Service/test_stage56.py
/UML_Clarity_Service/backend/test_regex.py
/UML_Clarity_Service/backend/test_semantic.py
/UML_Clarity_Service/backend/test_stage56.py
/UML_Clarity_Service/test_nvidia.py
/Editor_Service/test_socket.py
