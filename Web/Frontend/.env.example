# Web/Frontend environment — copy to `.env` and adjust.
# All vars are build-time (Vite `import.meta.env.*`); the SPA bakes them in at build.
# Defaults below assume the full local stack (start_project.bat) on localhost.

# --- Service URLs (required for live data) ---
VITE_API_BASE_URL=http://localhost:8000        # Core API  (auth, projects, chats, KG, synthesis)
VITE_SRS_API_URL=http://localhost:8001         # SRS Service (PDF -> NLP)
VITE_SATELLITE_URL=http://localhost:8003       # Satellite  (Temporal Cards, KG snapshots, deltas)
VITE_EDITOR_BACKEND_URL=http://localhost:8004  # Editor Service (Socket.IO real-time editor)

# UML service. NOTE: code reads VITE_UML_URL (src/pages/uml/Dashboard.tsx).
# The private .env historically had VITE_UML_API_URL — wrong name, ignored.
# Use VITE_UML_URL. Falls back to http://<host>:8007 if unset.
VITE_UML_URL=http://localhost:8005

# --- Optional ---
# Supabase powers the editor's realtime presence + a SettingsPage path.
# Leave UNSET to disable cleanly (client resolves to null, app does NOT crash).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ThreatLens is out of current scope (no src reads this). Kept for completeness.
# VITE_THREATLENS_URL=http://localhost:8002
